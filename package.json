{
  "name": "tomar-pasaj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:demo": "vite --mode demo",
    "dev:api": "tsx watch server/index.ts",
    "db:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-db.ps1",
    "seed:curated": "tsx server/seed-curated.ts",
    "publish:daily": "tsx server/daily.ts",
    "build": "tsc -p tsconfig.server.json && node scripts/copy-schema.mjs && tsc -p tsconfig.web.json && vite build",
    "start": "node server-dist/index.js",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "moderate": "node server-dist/moderate.js",
    "test": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
